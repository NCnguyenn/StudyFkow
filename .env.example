# AI StudyFlow - Environment Configuration

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=studyflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# PgBouncer Connection String (Use this for the application)
DATABASE_URL=postgresql://postgres:postgres@localhost:6432/studyflow

# ------------------------------------------------------------------------------
# 2. REDIS CONFIGURATION (Cache & Message Broker)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. BACKEND CONFIGURATION (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. TIMEZONE & LOCALIZATION
# ------------------------------------------------------------------------------
# Backend acts as authority. Always uses UTC internally.
TZ=UTC

# ------------------------------------------------------------------------------
# 6. AI PIPELINE CONFIGURATION
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
